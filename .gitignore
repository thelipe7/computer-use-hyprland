# Everything Cargo builds. Reproducible from the sources and the lockfile, so
# none of it belongs in history.
target/

# rustfmt leaves these behind.
**/*.rs.bk

# Editors and IDEs. These belong in a global gitignore, but a contributor
# without one should not have to learn that in a pull request review.
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# What the operating system's file browser leaves behind.
.DS_Store
Thumbs.db

# Python's bytecode cache, from running scripts/mcp_safety_check.py.
__pycache__/
*.py[cod]

# Local environment overrides, which is where a token or a socket path ends
# up if anybody writes one down.
.env
.env.local
